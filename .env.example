# ── Data Source Credentials ─────────────────────────────────────────
# Required for web scraping (tnpublicnotice.com or your state's notice site)
TNPN_EMAIL=your_email@example.com
TNPN_PASSWORD=your_password_here

# 2Captcha API key for reCAPTCHA v2 solving (~$2.99/1000 solves)
# Sign up at https://2captcha.com
CAPTCHA_API_KEY=your_2captcha_api_key_here

# ── CRM Integration ────────────────────────────────────────────────
# DataSift.ai (formerly REISift) — automated upload + enrich + skip trace
DATASIFT_EMAIL=your_datasift_email@example.com
DATASIFT_PASSWORD=your_datasift_password_here

# ── Enrichment API Keys ────────────────────────────────────────────
# Smarty (address standardization, USPS validation, geocoding)
# Sign up at https://smarty.com — free tier: 250 lookups/month
SMARTY_AUTH_ID=your_smarty_auth_id
SMARTY_AUTH_TOKEN=your_smarty_auth_token

# OpenWeb Ninja (Zillow property data — Zestimate, MLS, equity)
# Sign up at https://openwebninja.com — free tier: 100 requests/month
OPENWEBNINJA_API_KEY=your_openwebninja_api_key

# Anthropic (Claude Haiku — LLM parsing, obituary search, entity research)
# Sign up at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Serper.dev (Google Search — DM address lookup)
# Sign up at https://serper.dev — free tier: 2,500 queries
SERPER_API_KEY=your_serper_api_key

# Firecrawl (JS-rendered page scraping — DM address extraction)
# Sign up at https://firecrawl.dev — free tier: 500 pages
FIRECRAWL_API_KEY=fc-your-key-here

# ── Skip Trace & Phone Validation ──────────────────────────────────
# Tracerfy (batch skip trace — phones, emails, mailing addresses)
# $0.02/record — sign up at https://tracerfy.com
TRACERFY_API_KEY=your_tracerfy_api_key

# Trestle (phone scoring — 5-tier dial priority)
# $0.015/phone — sign up at https://trestleiq.com
TRESTLE_API_KEY=your_trestle_api_key
# Affiliate free-then-paid routing (router = _api/clients/trestle_router.py).
# Exhausts the FREE key's 1,000 lookups first, then bills on the PAID key.
# Trestle has NO usage API — the router tracks spend locally in _api/data/trestle_usage.json
# and fails over on the server's 429 QUOTA_EXCEEDED (or a 403 disabled-key) signal.
TRESTLE_FREE_API_KEY=your_trestle_affiliate_free_key   # 1,000 free lookups
TRESTLE_PAID_API_KEY=your_trestle_paid_key             # billed after free is exhausted
# TRESTLE_FREE_LIMIT=1000            # size of the free allotment
# TRESTLE_FREE_RESET=cumulative      # "cumulative" (one-time) or "monthly" (resets each month)
# TRESTLE_LEGACY_IS_FREE=0           # if only TRESTLE_API_KEY is set, treat it as free (1) vs paid (0)

# Enformion / Endato Person Search (deep-prospecting Primary Path — grounded heir graph + DOD)
# ~$0.35/match (misses free). API access-profile creds from Enformion Console > API (NOT website login)
ENFORMION_AP_NAME=your_enformion_access_profile_name
ENFORMION_AP_PASSWORD=your_enformion_access_profile_password

# ── Apify (cloud runs + consolidation) ─────────────────────────────
# API token to pull dataset records from past Actor runs
# (used by consolidate_foreclosures.py). Get it at:
# Apify Console > Settings > API & Integrations.
APIFY_TOKEN=apify_api_your_token_here

# ── Scrapfly (scraping backend: proxy + anti-bot + CAPTCHA + screenshots) ──
# When set, the gated notice detail fetch routes through Scrapfly instead of
# Playwright + 2Captcha. Get a key at https://scrapfly.io (dashboard).
SCRAPFLY_KEY=scp-live-your_key_here
# Backend selector: "scrapfly" (default when SCRAPFLY_KEY is set) or "playwright".
# SCRAPE_BACKEND=scrapfly
# Optional tuning:
# SCRAPFLY_COUNTRY=us
# SCRAPFLY_RENDER_WAIT_MS=3500
# SCRAPFLY_TIMEOUT_MS=90000
# SCRAPFLY_MAX_RETRIES=2
# Proxy pool for the generic ASP fallback fetcher (scrapfly_browser.py / deep-prospecting L3).
# Residential clears Cloudflare/JS county+genealogy portals; datacenter is cheaper but weaker.
# SCRAPFLY_PROXY_POOL=public_residential_pool

# ── Notifications ──────────────────────────────────────────────────
# Slack or Discord webhook for daily run summaries + error alerts
# Discord: use /slack suffix: https://discord.com/api/webhooks/{id}/{token}/slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Telnyx (caller-ID reputation monitor: Deal Room _api/caller-reputation) ──
# Powers the Telnyx-native caller reputation stack (L1 CDR own-traffic + L2 Number
# Reputation + remediation). Needs API access to the Telnyx account that OWNS the DIDs
# (handover Section 7). v2 API key from portal.telnyx.com -> API Keys.
# TELNYX_API_KEY=KEY_your_v2_api_key_here
# Enterprise id from `telnyx_setup.py register` (only after L2 / Number Reputation is enabled):
# TELNYX_ENTERPRISE_ID=

# ── Dropbox Auto-Polling (courthouse photo import) ─────────────────
# Create a Dropbox app at https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret
DROPBOX_REFRESH_TOKEN=your_refresh_token
DROPBOX_POLL_INTERVAL=900
DROPBOX_ROOT_FOLDER=TN Public Notice

# ── LLM Backend (optional — defaults to Anthropic) ─────────────────
# Switch to local Ollama or OpenRouter for cheaper/free LLM calls
LLM_BACKEND=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001          # default model for all LLM calls
# Higher-quality model for the accuracy-critical obituary identity + heir/survivor
# extraction (a wrong heir map sends the whole deal down the wrong path).
# OBITUARY_LLM_MODEL=claude-sonnet-4-6
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1/
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ── Google Drive (optional — CSV backup) ────────────────────────────
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id
# GOOGLE_SERVICE_ACCOUNT_KEY=base64_encoded_json_key

# ── Ancestry.com (optional — SSDI + obituary collection) ───────────
# Requires World Explorer subscription ($29/month)
# ANCESTRY_EMAIL=your_email@example.com
# ANCESTRY_PASSWORD=your_password
SERPAPI_KEY=

# ---- Two-way SMS agent (src/sms_agent) ----------------------------
# Receiver. The secret is in the webhook URL path because neither smrtPhone
# nor DataSift signs its payloads.
SMS_AGENT_WEBHOOK_SECRET=generate_a_long_random_string
# SMS_AGENT_ALLOWED_IPS=1.2.3.4,5.6.7.8
# SMS_AGENT_HOST=0.0.0.0
# SMS_AGENT_PORT=8080

# smrtPhone transport. The public API (POST /sms/send, X-Auth-smrtPhone) is
# text-only, which is all a reply is; it was the MMS/image path that had no API.
# auto = try the API, fall back to the browser session. api | session force one.
SMS_AGENT_TRANSPORT=auto
SMRTPHONE_API_KEY=
SMRTPHONE_NUMBERS=["+18653241736"]
# SMRTPHONE_NUMBERS_FILE=config/sms_numbers.json
# Session fallback: capture with _api/smrtphone_login.py. Note the session path
# sends from the account default caller ID only, so the number pool is unused.
# SMRTPHONE_STATE_FILE=smrtphone_state.json
# SMS_AGENT_SESSION_HEADLESS=1

# Autonomy ladder: 1 classify | 2 +escalate | 3 +draft | 4 +auto-send
SMS_AGENT_PHASE=1
# Leave at 1 until a live send has been watched end to end.
SMS_AGENT_DRY_RUN=1

# Identity. Each thread is signed by the person ASSIGNED to that record, mapped
# in config/sms_senders.json (assigned_to uuid -> first name, e.g. "Adriana").
# SENDER_NAME is only the fallback for an unassigned record. Both blank means
# threads go out unsigned, which is correct: the agent may never invent a name.
SMS_AGENT_SENDER_NAME=
# SMS_AGENT_SENDERS_FILE=config/sms_senders.json
# We NEVER say a company name (litigation bait). The agent describes itself by
# locality from the record's own county. This is only the fallback.
SMS_AGENT_LOCALITY=Blount County

# Prospector handoff channel. Falls back to SLACK_WEBHOOK_URL if unset.
SMS_AGENT_SLACK_WEBHOOK=

# Guardrails
# SMS_AGENT_MAX_TURNS=6
# SMS_AGENT_CONFIDENCE_FLOOR=0.80
# SMS_AGENT_QUIET_START=8
# SMS_AGENT_QUIET_END=21
# SMS_AGENT_DAILY_CAP=75
# SMS_AGENT_MIN_GAP=20
# SMS_AGENT_SIFT_ACCOUNT=datasift-apikey
