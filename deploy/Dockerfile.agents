# SiftStack agents brain: Slack and DataSift in, the four-employee team at work, one SQLite queue
# on the volume.
#
# No browser: every vendor the employees touch (DataSift, SiftMap, SmartSkip, Trestle, Tracerfy,
# the county tax API, Claude) is plain HTTP. The Claude Agent SDK ships its own Claude Code binary,
# so there is no Node install. ffmpeg is here for ffprobe, which measures call recordings so a
# transcript can be checked against the real audio length.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY deploy/requirements-agents.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
# The team (roster, briefs, generated TEAM.md) and the skill library the employees carry.
COPY team/ ./team/
COPY skills/ ./skills/

# State lives on the volume; the container has no .env, every key is a Fly secret.
#   AGENTS_WORKSPACES_DIR  each employee's runtime workspace, outside /app so nothing unrelated loads
#   CLAUDE_CONFIG_DIR      Claude sessions on the volume, so an employee waiting on the operator can
#                          resume the same conversation after a redeploy
ENV AGENTS_DATA_DIR=/data \
    AGENTS_INLINE_WORKER=1 \
    AGENTS_TEAM_DIR=/app/team \
    AGENTS_SKILLS_DIR=/app/skills \
    AGENTS_WORKSPACES_DIR=/data/workspaces \
    CLAUDE_CONFIG_DIR=/data/claude \
    PYTHONPATH=/app/src

EXPOSE 8080
CMD ["uvicorn", "agents.brain:app", "--host", "0.0.0.0", "--port", "8080"]
