# SiftStack agents brain: DataSift webhooks in, agent work out, one SQLite queue on the volume.
#
# No browser: every vendor the Research agent touches (DataSift, SiftMap, SmartSkip, Trestle,
# Tracerfy, the county tax API, Claude) is plain HTTP. ffmpeg is here for ffprobe, which measures
# call recordings so a transcript can be checked against the real audio length.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY deploy/requirements-agents.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY skills/deep-prospecting-v5/ ./skills/deep-prospecting-v5/

# State lives on the volume; the container has no .env, every key is a Fly secret.
ENV AGENTS_DATA_DIR=/data \
    AGENTS_INLINE_WORKER=1 \
    PYTHONPATH=/app/src

EXPOSE 8080
CMD ["uvicorn", "agents.brain:app", "--host", "0.0.0.0", "--port", "8080"]
